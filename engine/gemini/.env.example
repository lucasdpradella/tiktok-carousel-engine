# Chave Gemini API (Google AI Studio: https://aistudio.google.com/app/apikey)
# Billing precisa estar ativo no Google Cloud Console pra usar endpoints de imagem.
GEMINI_API_KEY=AIzaSy...

# (opcional) Modelo padrao de imagem — sobrescreve o default 'gemini-2.5-flash-image'
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# (opcional) Modelo padrao de texto — sobrescreve o default 'gemini-2.5-flash'
# GEMINI_TEXT_MODEL=gemini-2.5-flash
