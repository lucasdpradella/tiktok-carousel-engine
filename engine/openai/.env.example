# Chave OpenAI (https://platform.openai.com/api-keys)
# Billing pré-pago precisa estar carregado (https://platform.openai.com/account/billing)
OPENAI_API_KEY=sk-proj-...

# (opcional) Modelo padrao de texto — sobrescreve o default 'gpt-4o-mini'
# OPENAI_TEXT_MODEL=gpt-4o-mini

# (opcional) Binary do Python pros templates Pradex (slide_tensao.py, slide_resolucao.py)
# Default 'python3'. Em Windows pode precisar 'python' ou caminho absoluto.
# OPENAI_PYTHON_BIN=python3

# Numeração de capítulo e fila de temas: NÃO ficam mais em env nem no Supabase.
# Vivem versionadas em engine/openai/data/ (desde 2026-06-17):
#   - data/temas.json  → array ordenado dos temas que faltam publicar
#   - data/estado.json → { indice_atual, capitulo_offset, total_capitulos }
# chapter = capitulo_offset + indice_atual. Avançar a fila: `npm run avancar`.

# TikTok Content Posting API (Fase 4 semi-auto, desde 2026-06-18).
# Credenciais de Production do app PRADEX. No CI são GitHub Secrets; localmente,
# só pra testar a Fase 2 (--post). NUNCA commitar valores reais.
#   - TIKTOK_CLIENT_KEY / TIKTOK_CLIENT_SECRET: App details no developers.tiktok.com
#   - TIKTOK_REFRESH_TOKEN: gerado 1x via `node scripts/tiktok-oauth-prod.mjs`
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# (opcional) Base pública do GitHub Pages que serve docs/. Default já aponta pro repo.
# PAGES_BASE_URL=https://lucasdpradella.github.io/tiktok-carousel-engine
