# (opcional) Modelo padrao de texto — sobrescreve o default 'gpt-4o-mini'
# OPENAI_TEXT_MODEL=gpt-4o-mini

# upload-post.com API key (JWT) — usado pra agendar post no TikTok
UPLOAD_POST_API_KEY=

# Supabase (já provisionado em sa-east-1, projeto tiktok-engine)
SUPABASE_URL=https://ujwkxlzdhyqhfqioftfc.supabase.co
