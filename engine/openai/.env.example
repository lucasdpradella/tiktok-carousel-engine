# Chave OpenAI (https://platform.openai.com/api-keys)
# Billing pré-pago precisa estar carregado (https://platform.openai.com/account/billing)
OPENAI_API_KEY=sk-proj-...

# (opcional) Modelo padrao de texto — sobrescreve o default 'gpt-4o-mini'
# OPENAI_TEXT_MODEL=gpt-4o-mini

# (opcional) Binary do Python pros templates Pradex (slide_tensao.py, slide_resolucao.py)
# Default 'python3'. Em Windows pode precisar 'python' ou caminho absoluto.
# OPENAI_PYTHON_BIN=python3

# Numeração de capítulo (Manual do Dinheiro / Pradex)
# CHAPTER_OFFSET = nº do PRÓXIMO capítulo quando ainda não há posts published nesta engine.
#   - Default 4 (porque Lucas já tem CAP. 03 publicado fora desta engine).
#   - Cada post published incrementa em 1 (chapter = OFFSET + count).
# CHAPTER_TOTAL = total da série (aparece no rodapé "uma série em N partes"). Default 8.
# CHAPTER_OFFSET=4
# CHAPTER_TOTAL=8

# upload-post.com API key (JWT) — usado pra agendar post no TikTok
UPLOAD_POST_API_KEY=

# Supabase (já provisionado em sa-east-1, projeto tiktok-engine)
SUPABASE_URL=https://ujwkxlzdhyqhfqioftfc.supabase.co
SUPABASE_KEY=
