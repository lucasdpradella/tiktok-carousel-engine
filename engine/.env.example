# ─────────────────────────────────────────────────────────────
# tiktok-carousel-engine — variáveis de ambiente
# Copia pra .env (ou seta no n8n / Vercel / Supabase respectivamente)
# ─────────────────────────────────────────────────────────────

# ── LLM (roteiro) ──────────────────────────────────────────────
# Escolher 1 (n8n usa o que tiver setado)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Modelo de imagem (background) ──────────────────────────────
# Escolher 1. Ideogram recomendado pra estética com texto.
IDEOGRAM_API_KEY=
REPLICATE_API_TOKEN=                 # pra Flux 1.1 Pro
FAL_KEY=                             # alternativa pra Flux

# ── Supabase ────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...      # service_role (n8n usa, NUNCA expor no client)
SUPABASE_ANON_KEY=eyJ...              # anon (Vercel usa pra reads públicos)
SUPABASE_STORAGE_BUCKET=carousels     # bucket público pré-criado

# ── Vercel (composição de slide) ────────────────────────────────
# URL do projeto Vercel deployado. n8n chama assim:
#   ${VERCEL_RENDER_URL}/api/slide?template=financa-capa&titulo=...&corpo=...&bg=...
VERCEL_RENDER_URL=https://tiktok-carousel-engine.vercel.app
VERCEL_RENDER_TOKEN=                  # bearer opcional pra proteger o endpoint

# ── TikTok (Path A nativo, só depois do audit) ─────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=                  # gerado via OAuth, refresh em 24h
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=                       # da conta alvo

# ── upload-post.com (Path B fallback) ──────────────────────────
UPLOAD_POST_API_KEY=
UPLOAD_POST_PROFILE=lucaspradella     # nome do profile criado lá

# ── n8n (se self-hosted, opcional) ──────────────────────────────
N8N_WEBHOOK_URL=https://n8n.lucaspradella.com/webhook
